<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="main-view" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainController">

    <top>
        <VBox>
         <HBox prefWidth="200.0">
            <children>
                  <Label prefHeight="81.0" prefWidth="93.0" styleClass="app-title" text="IMTPS" textFill="#919191">
                      <padding>
                          <Insets bottom="4" left="16" right="16" top="16" />
                      </padding>
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
                  </Label>
               <Region HBox.hgrow="ALWAYS" />
               <Label layoutX="10.0" layoutY="10.0" prefHeight="81.0" prefWidth="92.0" styleClass="app-title" text="Availability:">
                  <padding>
                     <Insets bottom="4" left="16" right="16" top="16" />
                  </padding>
                  <font>
                     <Font name="System Bold" size="10.0" />
                  </font>
               </Label>
               <VBox nodeOrientation="RIGHT_TO_LEFT" prefHeight="82.0" prefWidth="147.0">
                  <children>
                     <HBox prefWidth="200.0">
                        <children>
                           <Label prefHeight="25.0" prefWidth="25.0" text="Start">
                              <HBox.margin>
                                 <Insets right="5.0" top="15.0" />
                              </HBox.margin>
                           </Label>
                           <Spinner fx:id="availabilityStartMinSpinner" editable="true" maxWidth="50.0" prefWidth="50.0">
                              <HBox.margin>
                                 <Insets top="15.0" />
                              </HBox.margin>
                           </Spinner>
                           <Spinner fx:id="availabilityStartHrSpinner" editable="true" maxWidth="50.0">
                              <HBox.margin>
                                 <Insets left="10.0" top="15.0" />
                              </HBox.margin>
                           </Spinner>
                        </children>
                     </HBox>
                     <HBox layoutX="10.0" layoutY="10.0">
                        <children>
                           <Label prefHeight="26.0" prefWidth="20.0" text="End">
                              <HBox.margin>
                                 <Insets right="10.0" top="15.0" />
                              </HBox.margin>
                           </Label>
                           <Spinner fx:id="availabilityEndMinSpinner" editable="true" maxWidth="50.0" prefWidth="50.0">
                              <HBox.margin>
                                 <Insets top="15.0" />
                              </HBox.margin>
                           </Spinner>
                           <Spinner fx:id="availabilityEndHrSpinner" editable="true" maxWidth="50.0">
                              <HBox.margin>
                                 <Insets left="10.0" top="15.0" />
                              </HBox.margin>
                           </Spinner>
                        </children>
                     </HBox>
                  </children>
               </VBox>
            </children>
            <VBox.margin>
               <Insets right="15.0" />
            </VBox.margin>
         </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar">
                <padding>
                    <Insets bottom="10" left="16" right="16" top="10" />
                </padding>

                <Label text="Focus Mode:" />
                <ComboBox fx:id="focusModeComboBox" prefWidth="150" promptText="Select focus mode" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="addTaskButton" onAction="#handleAddTask" text="+ Add Task" />
                <Button fx:id="editTaskButton" disable="true" onAction="#handleEditTask" text="Edit" />
                <Button fx:id="deleteTaskButton" disable="true" onAction="#handleDeleteTask" text="Delete" />
                <Button fx:id="compareButton" onAction="#handleCompareStrategies" styleClass="primary-button" text="Compare Strategies" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="taskTable">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="180" text="Task" />
                <TableColumn fx:id="scheduledStartColumn" prefWidth="150" text="Scheduled Start" />
                <TableColumn fx:id="scheduledEndColumn" prefWidth="150" text="Scheduled End" />
                <TableColumn fx:id="deadlineColumn" prefWidth="150" text="Deadline" />
                <TableColumn fx:id="importanceColumn" prefWidth="100" text="Importance" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="status-bar">
            <padding>
                <Insets bottom="8" left="16" right="16" top="8" />
            </padding>
            <Label fx:id="taskCountLabel" text="0 tasks" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="nameOfStrategyLabel" text="Earliest Deadline First Strategy" textFill="#919191" />
         <Region layoutX="79.0" layoutY="18.0" HBox.hgrow="ALWAYS" />
         <Button fx:id="GenerateScheduleBtn" mnemonicParsing="false" onAction="#handleGenerateSchedule" text="Generate Schedule" />
        </HBox>
    </bottom>

</BorderPane>
