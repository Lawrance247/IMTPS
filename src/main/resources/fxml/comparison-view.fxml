<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="comparison-view" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ComparisonController">

    <top>
        <VBox>
            <Label styleClass="app-title" text="Strategy Comparison" textFill="#919191ab">
                <padding>
                    <Insets bottom="4" left="16" right="16" top="16" />
                </padding>
            <font>
               <Font name="System Bold" size="20.0" />
            </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="toolbar">
                <padding>
                    <Insets bottom="10" left="16" right="16" top="0" />
                </padding>
                <Label text="Focus Mode:" />
                <Label fx:id="focusModeLabel" styleClass="focus-mode-value" />
            <Region HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="pickPrefferedStrategy" minWidth="190.0" promptText="Pick Your Preffered Strategy" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="edge-to-edge">
            <VBox spacing="16">
                <padding>
                    <Insets bottom="16" left="16" right="16" top="16" />
                </padding>

                <!-- The two generated schedules, side by side -->
                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label fx:id="strategyALabel" styleClass="section-title" text="Strategy A" />
                        <TableView fx:id="scheduleATable" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="nameColumnA" prefWidth="140" text="Task" />
                                <TableColumn fx:id="startColumnA" prefWidth="130" text="Start" />
                                <TableColumn fx:id="endColumnA" prefWidth="130" text="End" />
                                <TableColumn fx:id="deadlineColumnA" prefWidth="130" text="Deadline" />
                                <TableColumn fx:id="importanceColumnA" prefWidth="90" text="Importance" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label fx:id="strategyBLabel" styleClass="section-title" text="Strategy B" />
                        <TableView fx:id="scheduleBTable" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="nameColumnB" prefWidth="140" text="Task" />
                                <TableColumn fx:id="startColumnB" prefWidth="130" text="Start" />
                                <TableColumn fx:id="endColumnB" prefWidth="130" text="End" />
                                <TableColumn fx:id="deadlineColumnB" prefWidth="130" text="Deadline" />
                                <TableColumn fx:id="importanceColumnB" prefWidth="90" text="Importance" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </HBox>

                <Separator />

                <!-- Metric-by-metric comparison, with definitions shown directly rather than hidden in tooltips -->
                <VBox spacing="8">
                    <Label styleClass="section-title" text="Comparison Metrics" />
                    <TableView fx:id="metricsTable" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="metricNameColumn" prefWidth="150" text="Metric" />
                            <TableColumn fx:id="metricDefinitionColumn" prefWidth="320" text="Definition" />
                            <TableColumn fx:id="metricDirectionColumn" prefWidth="80" text="Better" />
                            <TableColumn fx:id="metricAColumn" prefWidth="110" text="Strategy A" />
                            <TableColumn fx:id="metricBColumn" prefWidth="110" text="Strategy B" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="status-bar">
            <padding>
                <Insets bottom="12" left="16" right="16" top="12" />
            </padding>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="closeButton" onAction="#handleClose" text="Close" />
        </HBox>
    </bottom>

</BorderPane>
